    "切换后新的对话将使用 %@ 读写长期记忆；已有记忆文件不删除。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After switching, new conversations will use %@ to read and write long-term memory. Existing memory files aren't deleted."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçtikten sonra yeni sohbetler uzun süreli hafızayı okumak ve yazmak için %@ kullanır. Mevcut hafıza dosyaları silinmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换后新的对话将使用 %@ 读写长期记忆；已有记忆文件不删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換後新的對話將使用 %@ 讀寫長期記憶；已有記憶檔案不刪除。"
          }
        }
      }
    },
    "切换后新的对话将使用该档案的模型、技能与记忆；当前对话不受影响。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After switching, new conversations will use this profile's models, skills, and memory. The current conversation isn't affected."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçtikten sonra yeni sohbetler bu profilin modellerini, becerilerini ve hafızasını kullanır. Geçerli sohbet etkilenmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换后新的对话将使用该档案的模型、技能与记忆；当前对话不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換後新的對話將使用該檔案的模型、技能與記憶；目前對話不受影響。"
          }
        }
      }
    },
