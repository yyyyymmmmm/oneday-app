            "value": "The check was sent, but the status hadn't updated when checked again. Refresh to verify."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol gönderildi ancak yeniden kontrol edildiğinde durum güncellenmemişti. Doğrulamak için yenileyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
