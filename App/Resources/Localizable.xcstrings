    "只改这台手机上的称呼，不改动服务器上的智能体身份。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只改这台手机上的称呼，不改动服务器上的智能体身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只改這台手機上的稱呼，不改動伺服器上的智慧代理身份。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes only the name on this phone. The agent identity on the server is not changed."
          }
        }
      }
    },
    "名字最多 20 个字。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
