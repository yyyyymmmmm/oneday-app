        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将从服务端配置里移除这家提供商，它的密钥也会一并删掉；正在用它的会话可能受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將從伺服器端設定裡移除這家提供商，它的金鑰也會一併刪掉；正在用它的對話可能受影響。"
          }
        },
        "en": {
