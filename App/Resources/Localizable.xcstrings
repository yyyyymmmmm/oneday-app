          }
        }
      }
    },
    "智能体可调用：读取同步副本里的照片清单统计（总数、按月、收藏与截图数），不取原图": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Callable by the agent: read photo inventory statistics from the synced copy (totals, by month, favorites and screenshot counts). Original photos aren't fetched"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan tarafından çağrılabilir: eşitlenmiş kopyadan fotoğraf envanteri istatistiklerini okuyabilir (toplamlar, aya göre, favori ve ekran görüntüsü sayıları). Orijinal fotoğraflar getirilmez"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
