    "OneDay 不提供账号体系，你的数据只在你的服务器上。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OneDay has no accounts of its own — your data lives only on your server."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OneDay'in kendi hesapları yoktur — verileriniz yalnızca sunucunuzda bulunur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OneDay 不提供账号体系，你的数据只在你的服务器上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OneDay 不提供帳號體系，你的資料只在你的伺服器上。"
          }
        }
      }
    },
    "OneDay 发起": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Started by OneDay"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OneDay tarafından başlatıldı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
