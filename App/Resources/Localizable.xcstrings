    "批准后修改会写入技能并生效；驳回则保持原样。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once approved, the changes are written into the skill and take effect. If rejected, everything stays as it was."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylandığında değişiklikler beceriye yazılır ve geçerli olur. Reddedilirse her şey olduğu gibi kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准后修改会写入技能并生效；驳回则保持原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批准後修改會寫入技能並生效；駁回則保持原樣。"
          }
        }
      }
    },
    "批准后写入会生效；驳回则不会写入。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once approved, the write takes effect. If rejected, nothing is written."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylandığında yazma geçerli olur. Reddedilirse hiçbir şey yazılmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准后写入会生效；驳回则不会写入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批准後寫入會生效；駁回則不會寫入。"
          }
        }
      }
    },
    "批准后原有记忆会被新内容替换；驳回则保持原样。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once approved, the existing memory is replaced by the new content. If rejected, everything stays as it was."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylandığında mevcut hafıza yeni içerikle değiştirilir. Reddedilirse her şey olduğu gibi kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准后原有记忆会被新内容替换；驳回则保持原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批准後原有記憶會被新內容替換；駁回則保持原樣。"
          }
        }
      }
    },
    "批准后整个技能会被删除；驳回则保持原样。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once approved, the whole skill is deleted. If rejected, everything stays as it was."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylandığında beceri tamamen silinir. Reddedilirse her şey olduğu gibi kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
