        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼板裡現在沒有文字（可能是圖片，或者本來就是空的）。"
          }
        }
      }
    },
    "副本在你自己的服务器上，智能体查副本；开着权限就自动同步": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy lives on your own server and the agent queries the copy. Sync runs automatically while permission is on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "副本在你自己的服务器上，智能体查副本；开着权限就自动同步"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "副本在你自己的伺服器上，智慧代理查副本；開著權限就自動同步"
          }
        }
      }
    },
    "副本已删除。权限还开着，下次打开 App 会自动重新同步回来；不想再同步就关掉上方开关。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy deleted. Permission is still on, so it will sync back automatically next time you open the app. Turn off the switch above if you don't want it to sync again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "副本已删除。权限还开着，下次打开 App 会自动重新同步回来；不想再同步就关掉上方开关。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "副本已刪除。權限還開著，下次打開 App 會自動重新同步回來；不想再同步就關掉上方開關。"
          }
        }
      }
    },
