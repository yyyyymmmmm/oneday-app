      }
    },
    "之前在系统里没允许「%@」。去设置里打开它，回来会自动接着办刚才的事，不用重新说一遍。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wasn't allowed in system settings before. Turn it on in Settings, and the task will pick up right where it left off when you come back — no need to ask again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前在系统里没允许「%@」。去设置里打开它，回来会自动接着办刚才的事，不用重新说一遍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之前在系統裡沒允許「%@」。去設定裡打開它，回來會自動接著辦剛才的事，不用重新說一遍。"
          }
        }
      }
    },
    "允许": {
      "extractionState": "manual",
