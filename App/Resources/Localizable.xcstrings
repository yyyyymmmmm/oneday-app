            "value": "The main conversation is your one command seat: it is protected by design, and this page offers no rename, archive, or delete for it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana sohbet tek komuta koltuğunuzdur: tasarım gereği korunur ve bu sayfa için yeniden adlandırma, arşivleme veya silme sunmaz."
          }
        },
