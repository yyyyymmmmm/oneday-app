          }
        }
      }
    },
    "请把 App 升级到 %@ 版，伴生服务才能正常配合工作。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please update the app to version %@ so it can work properly with the companion service."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请把 App 升级到 %@ 版，伴生服务才能正常配合工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請把 App 升級到 %@ 版，伴生服務才能正常配合工作。"
          }
        }
      }
    },
    "请把文件重新保存好，确认真的存在后，再把正确路径单独写一行发给我。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please save the file again, make sure it really exists, and then send me the correct path on a line of its own."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请把文件重新保存好，确认真的存在后，再把正确路径单独写一行发给我。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請把檔案重新保存好，確認真的存在後，再把正確路徑單獨寫一行發給我。"
          }
        }
      }
    },
    "请求数": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求数"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求數"
          }
        }
      }
    },
    "请确认地址正确、服务器已启动，并且当前网络可以访问。企业网络或代理可能拦截请求。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the address is right, the server is running, and your current network can reach it. Work networks or proxies may block the request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认地址正确、服务器已启动，并且当前网络可以访问。企业网络或代理可能拦截请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認地址正確、伺服器已啟動，並且目前網路可以存取。企業網路或代理可能攔截請求。"
          }
        }
      }
    },
    "请确认填的凭据与服务器上的一致，是否已被撤销或改过，然后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the credential matches the one on your server and hasn't been revoked or changed, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认填的凭据与服务器上的一致，是否已被撤销或改过，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認填的憑據與伺服器上的一致，是否已被撤銷或改過，然後重試。"
          }
        }
      }
    },
    "请稍后再试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍后再试。"
