        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler yalnızca bu telefona iletilir, asla bir sunucu üzerinden itilmez; sistem iznini kapatmak onları durdurur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知只发到你这台手机，不经服务器推送；系统通知权限关掉后就发不了。"
