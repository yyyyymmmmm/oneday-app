    "步数/睡眠/心率等每日摘要 · 待签名权益到位后开通": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily summaries of steps, sleep, heart rate, etc. · Available once signing entitlements are in place"
          }
        },
        "zh-Hans": {
          "stringUnit": {
