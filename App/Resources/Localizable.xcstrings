    "设备会话在线：智能体发来调用时，这台手机现读现回。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device session online: when the agent sends a call, this phone reads and answers on the spot."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz oturumu çevrimiçi: ajan bir çağrı gönderdiğinde bu telefon anında okur ve yanıtlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备会话在线：智能体发来调用时，这台手机现读现回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置工作階段在線：智慧代理發來呼叫時，這台手機現讀現回。"
          }
        }
      }
    },
    "设备会话对不上，回到前台重连后再同步": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device session doesn't match. Bring the app to the foreground to reconnect, then sync again"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz oturumu eşleşmiyor. Yeniden bağlanmak için uygulamayı ön plana getirin, sonra tekrar eşitleyin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备会话对不上，回到前台重连后再同步"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置工作階段對不上，回到前景重連後再同步"
          }
        }
      }
    },
    "设备会话已过期。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device session has expired."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
