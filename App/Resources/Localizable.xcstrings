        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "智慧代理可呼叫：列出、讀取、寫入 OneDay 自己資料夾裡的文字檔案，資料夾之外的任何東西都碰不到。這一件沒有系統權限可開可關，詳情頁裡的開關就是唯一的門"
          }
        },
        "en": {
          "stringUnit": {
