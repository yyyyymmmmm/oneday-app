    },
    "检查的是 Hermes 本体回的健康状态（打开本页时当场问的，不需要登录）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks the health status returned by Hermes itself (asked on the spot when this page opens — no sign-in needed)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查的是 Hermes 本体回的健康状态（打开本页时当场问的，不需要登录）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
