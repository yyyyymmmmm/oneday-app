            "value": "This companion service is on version %@ and doesn't have the ledger yet. Once it upgrades, the progress of every job will start recording here automatically."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yardımcı hizmet %@ sürümünde ve henüz defteri yok. Yükseltildiğinde, her işin ilerlemesi burada otomatik olarak kaydedilmeye başlayacak."
          }
        },
