    },
    "只回书目信息，音频文件不出手机；订阅内容能不能播，取决于你的订阅状态。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只回书目信息，音频文件不出手机；订阅内容能不能播，取决于你的订阅状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只回書目資訊，音訊檔案不出手機；訂閱內容能不能播，取決於你的訂閱狀態。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
