          "stringUnit": {
            "state": "translated",
            "value": "請先寫下要記住的內容。"
          }
        }
      }
    },
    "请勿在公开议题中粘贴密钥、服务器地址或个人数据。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never paste keys, server addresses, or personal data into public issues."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请勿在公开议题中粘贴密钥、服务器地址或个人数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請勿在公開議題中貼上金鑰、伺服器地址或個人資料。"
          }
        }
      }
    },
    "请填写监测名称。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a monitor name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
