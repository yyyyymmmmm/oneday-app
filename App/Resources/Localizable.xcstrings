    "每天早上我会想一轮，你也可以点右上角＋先记一个": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I think up a round every morning. You can also tap + at the top right to note one first"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sabah bir tur düşünürüm. Önce sağ üstteki + işaretine dokunup kendiniz de bir not düşebilirsiniz"
          }
