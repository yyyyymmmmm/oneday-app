        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「總是允許」沒能記住（規則建立失敗），這條仍在待批中。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Always allow” couldn't be remembered (the rule couldn't be created). This item is still pending."
          }
        }
      }
    },
