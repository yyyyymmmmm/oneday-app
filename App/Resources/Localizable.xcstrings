    "形象与名称只保存在本机，不回写服务器。配置档案决定人设，在「智能体」里管理。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance and name are stored only on this device and never written back to the server. Profiles define the persona and are managed under “Agent”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünüm ve ad yalnızca bu cihazda saklanır ve asla sunucuya geri yazılmaz. Profiller personayı tanımlar ve “Ajan” altında yönetilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "形象与名称只保存在本机，不回写服务器。配置档案决定人设，在「智能体」里管理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "形象與名稱只儲存在本機，不回寫伺服器。配置檔案決定人設，在「智慧代理」裡管理。"
          }
        }
      }
    },
