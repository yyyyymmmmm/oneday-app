          }
        }
      }
    },
    "请填写要盯的链接。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the link to watch."
          }
        },
        "zh-Hans": {
