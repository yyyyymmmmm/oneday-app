    "「总是允许」的规则与撤销": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules for “Always allow” and how to revoke them"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「总是允许」的规则与撤销"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「總是允許」的規則與撤銷"
