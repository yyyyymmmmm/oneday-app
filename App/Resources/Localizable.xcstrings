          "stringUnit": {
            "state": "translated",
            "value": "填导出时服务端回的那串路径。档案包生成在服务器上、导回同一台服务器是正道；手机本地文件目前没有上传通道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "填匯出時伺服器端回的那串路徑。檔案包產生在伺服器上、導回同一台伺服器是正道；手機本地檔案目前沒有上傳通道。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the path the server returned when exporting. The profile package is generated on the server, and importing it back to the same server is the proper route. There's currently no upload channel for local files on the phone."
          }
        }
