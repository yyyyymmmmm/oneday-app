    "闹钟": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鬧鐘"
          }
        }
      }
    },
    "真闹钟 · 穿透静音与专注，到点全屏响铃": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A real alarm · Rings full-screen, through Silent and Focus"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真闹钟 · 穿透静音与专注，到点全屏响铃"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "真鬧鐘 · 穿透靜音與專注，到點全屏響鈴"
          }
        }
      }
    },
    "智能体可调用：按你在对话里的确认设定真闹钟（定点或倒计时），响铃穿透静音与专注模式；也能查看闹钟列表、取消它设过的闹钟。系统闹钟不带标题，标题由 OneDay 记在这台手机上对账": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your agent can: set a real alarm (fixed time or countdown) after you confirm in chat — it rings through Silent and Focus; list alarms, and cancel ones it set. System alarms carry no title, so OneDay keeps titles on this phone for reference"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体可调用：按你在对话里的确认设定真闹钟（定点或倒计时），响铃穿透静音与专注模式；也能查看闹钟列表、取消它设过的闹钟。系统闹钟不带标题，标题由 OneDay 记在这台手机上对账"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "智慧代理可呼叫：按你在對話裡的確認設定真鬧鐘（定點或倒數計時），響鈴穿透靜音與專注模式；也能查看鬧鐘列表、取消它設過的鬧鐘。系統鬧鐘不帶標題，標題由 OneDay 記在這台手機上對帳"
          }
        }
      }
    },
    "按确认设真闹钟 · 可查看/取消": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set real alarms on confirm · List/cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按确认设真闹钟 · 可查看/取消"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按確認設真鬧鐘 · 可查看/取消"
          }
        }
      }
    },
    "闹钟由系统托管，App 不在前台也照常响；标题只记在这台手机上，不出手机。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms are kept by the system and ring even when the app isn't in front; titles stay on this phone only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟由系统托管，App 不在前台也照常响；标题只记在这台手机上，不出手机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鬧鐘由系統託管，App 不在前台也照常響；標題只記在這台手機上，不出手機。"
          }
        }
      }
    },
    "本地通知 · 到点在锁屏与通知中心提醒你": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local notifications · Appear on the Lock Screen and in Notification Center"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地通知 · 到点在锁屏与通知中心提醒你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地通知 · 到點在鎖定畫面與通知中心提醒你"
          }
        }
      }
    },
    "智能体可调用：按你在对话里的确认给你发一条本地通知（立即或延时）。待发通知最多 64 条，满了先报错、不硬塞": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your agent can: post a local notification (now or delayed) after you confirm in chat. At most 64 can be pending; when full it reports an error instead of forcing more in"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体可调用：按你在对话里的确认给你发一条本地通知（立即或延时）。待发通知最多 64 条，满了先报错、不硬塞"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "智慧代理可呼叫：按你在對話裡的確認給你發一條本地通知（立即或延時）。待發通知最多 64 條，滿了先報錯、不硬塞"
          }
        }
      }
    },
    "按确认发本地通知": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post local notifications on confirm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按确认发本地通知"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按確認發本地通知"
          }
        }
      }
    },
    "通知只发到你这台手机，不经服务器推送；系统通知权限关掉后就发不了。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are delivered only to this phone, never pushed through a server; turning the system permission off stops them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知只发到你这台手机，不经服务器推送；系统通知权限关掉后就发不了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知只發到你這台手機，不經伺服器推送；系統通知權限關掉後就發不了。"
          }
        }
      }
    },
    "打开目标": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Target"
          }
        },
        "zh-Hans": {
