          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama bu tür onayı henüz ele alamıyor — lütfen Hermes web arayüzünde ele alın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
