            "value": "Turn on the system permission above first, so the agent can use this item."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanın bu öğeyi kullanabilmesi için önce yukarıdaki sistem iznini açın."
          }
        },
        "zh-Hans": {
