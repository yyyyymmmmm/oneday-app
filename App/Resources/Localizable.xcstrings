        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names can be at most 20 characters."
          }
        }
      }
    },
    "头像只保存在这台手机上，换头像不会改动服务器上的智能体身份。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头像只保存在这台手机上，换头像不会改动服务器上的智能体身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頭像只儲存在這台手機上，更換頭像不會改動伺服器上的智慧代理身份。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The avatar is stored only on this phone. Changing it does not change the agent identity on the server."
          }
        }
      }
    },
