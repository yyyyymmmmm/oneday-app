          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置工作階段已過期。"
          }
        }
      }
    },
    "设备会话当前未连接：智能体现在叫不到这台手机；回到 App 前台、会话恢复在线后才可调用。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device session isn't connected right now: the agent can't reach this phone. Calls become possible once you bring the app to the foreground and the session is back online."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz oturumu şu an bağlı değil: ajan bu telefona ulaşamaz. Uygulamayı ön plana getirip oturum yeniden çevrimiçi olduğunda çağrılar mümkün olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备会话当前未连接：智能体现在叫不到这台手机；回到 App 前台、会话恢复在线后才可调用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置工作階段目前未連接：智慧代理現在叫不到這台手機；回到 App 前景、工作階段恢復在線後才可呼叫。"
          }
        }
      }
    },
