            "value": "現讀位置 · 查附近地點"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current location · nearby places"
          }
        }
      }
    },
    "位置只在你开着 App 时现读，不做后台定位、不存位置副本；精度随定位信号变化，回执里如实标明。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置只在你开着 App 时现读，不做后台定位、不存位置副本；精度随定位信号变化，回执里如实标明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位置只在你開著 App 時現讀，不做背景定位、不存位置副本；精度隨定位訊號變化，回執裡如實標明。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is read only while the app is open — no background tracking and no stored copies. Accuracy varies with the signal and is reported honestly in the result."
          }
        }
      }
    },
