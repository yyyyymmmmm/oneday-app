    "只删点子本身；已经转成的任务不会受影响。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the idea itself is deleted. Tasks already created from it aren't affected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删点子本身；已经转成的任务不会受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只刪點子本身；已經轉成的任務不會受影響。"
          }
        }
      }
    },
    "只删这份预设的定义；已经启用到服务端的设置不会被撤回。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only deletes the preset's definition; settings already enabled on the server are not rolled back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删这份预设的定义；已经启用到服务端的设置不会被撤回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只刪這份預設的定義；已經啟用到伺服器端的設定不會被撤回。"
          }
        }
      }
    },
    "只删这套组合的定义；已经启用到服务端的设置不会被撤回。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this combo's definition is deleted. Settings already activated on the server aren't withdrawn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删这套组合的定义；已经启用到服务端的设置不会被撤回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只刪這套組合的定義；已經啟用到伺服器端的設定不會被撤回。"
          }
        }
      }
    },
    "只回书目信息，音频文件不出手机；订阅内容能不能播，取决于你的订阅状态。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only catalog details are returned — audio files never leave the phone. Whether subscription content can play depends on your subscription."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只回书目信息，音频文件不出手机；订阅内容能不能播，取决于你的订阅状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只回書目資訊，音訊檔案不出手機；訂閱內容能不能播，取決於你的訂閱狀態。"
          }
        }
      }
    },
    "只回未完成项，不回已完成历史；你开启「数据同步」后，未完成清单会存一份在你自己的服务器上供智能体查询，可随时关掉并删除。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only unfinished items are returned, not completed history. Once you turn on Data Sync, the unfinished list is kept on your own server for the agent to query — you can turn it off and delete it anytime."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只回未完成项，不回已完成历史；你开启「数据同步」后，未完成清单会存一份在你自己的服务器上供智能体查询，可随时关掉并删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只回未完成項，不回已完成歷史；你開啟「資料同步」後，未完成清單會存一份在你自己的伺服器上供智慧代理查詢，可隨時關掉並刪除。"
          }
        }
      }
    },
    "只对当前对话生效，完整的模型设置在设置页。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to this conversation only. Full model settings are in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只对当前对话生效，完整的模型设置在设置页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只對目前對話生效，完整的模型設定在設定頁。"
          }
        }
      }
    },
    "只对这条对话生效": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to this conversation only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
