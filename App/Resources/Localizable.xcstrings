          "stringUnit": {
            "state": "translated",
            "value": "Status is read live from the server (the MCP server list) and matches the server's actual configuration. If the read fails, stale data is never shown in its place."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durum sunucudan canlı okunur (MCP sunucu listesi) ve sunucunun gerçek yapılandırmasıyla eşleşir. Okuma başarısız olursa yerine asla eski veri gösterilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态来自服务端实时读取（MCP 服务器列表），与服务器实际配置一致；读取失败不会拿旧数据冒充。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "狀態來自伺服器端即時讀取（MCP 伺服器列表），與伺服器實際設定一致；讀取失敗不會拿舊資料冒充。"
          }
        }
      }
    },
