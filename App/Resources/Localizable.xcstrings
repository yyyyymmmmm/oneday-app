    "只删点子本身；已经转成的任务不会受影响。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the idea itself is deleted. Tasks already created from it aren't affected."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca fikrin kendisi silinir. Ondan zaten oluşturulmuş görevler etkilenmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删点子本身；已经转成的任务不会受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只刪點子本身；已經轉成的任務不會受影響。"
          }
        }
      }
    },
    "只删这份预设的定义；已经启用到服务端的设置不会被撤回。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only deletes the preset's definition; settings already enabled on the server are not rolled back."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yalnızca ön ayarın tanımını siler; sunucuda zaten etkinleştirilmiş ayarlar geri alınmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删这份预设的定义；已经启用到服务端的设置不会被撤回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只刪這份預設的定義；已經啟用到伺服器端的設定不會被撤回。"
          }
        }
      }
    },
    "只删这套组合的定义；已经启用到服务端的设置不会被撤回。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this combo's definition is deleted. Settings already activated on the server aren't withdrawn."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu kombinasyonun tanımı silinir. Sunucuda zaten etkinleştirilmiş ayarlar geri çekilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删这套组合的定义；已经启用到服务端的设置不会被撤回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只刪這套組合的定義；已經啟用到伺服器端的設定不會被撤回。"
          }
        }
      }
    },
    "只回书目信息，音频文件不出手机；订阅内容能不能播，取决于你的订阅状态。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only catalog details are returned — audio files never leave the phone. Whether subscription content can play depends on your subscription."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca katalog ayrıntıları döndürülür — ses dosyaları telefondan hiç çıkmaz. Abonelik içeriğinin oynatılıp oynatılamayacağı aboneliğinize bağlıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只回书目信息，音频文件不出手机；订阅内容能不能播，取决于你的订阅状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只回書目資訊，音訊檔案不出手機；訂閱內容能不能播，取決於你的訂閱狀態。"
          }
        }
      }
    },
    "只回未完成项，不回已完成历史；你开启「数据同步」后，未完成清单会存一份在你自己的服务器上供智能体查询，可随时关掉并删除。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only unfinished items are returned, not completed history. Once you turn on Data Sync, the unfinished list is kept on your own server for the agent to query — you can turn it off and delete it anytime."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca tamamlanmamış öğeler döndürülür, tamamlanmış geçmiş değil. Veri Eşitleme'yi açtığınızda tamamlanmamışlar listesi ajanın sorgulaması için kendi sunucunuzda tutulur — istediğiniz zaman kapatıp silebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只回未完成项，不回已完成历史；你开启「数据同步」后，未完成清单会存一份在你自己的服务器上供智能体查询，可随时关掉并删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只回未完成項，不回已完成歷史；你開啟「資料同步」後，未完成清單會存一份在你自己的伺服器上供智慧代理查詢，可隨時關掉並刪除。"
          }
        }
      }
    },
    "只对当前对话生效，完整的模型设置在设置页。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to this conversation only. Full model settings are in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu sohbet için geçerlidir. Tam model ayarları Ayarlar'dadır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只对当前对话生效，完整的模型设置在设置页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只對目前對話生效，完整的模型設定在設定頁。"
          }
        }
      }
    },
    "只改名字，文件还在原来的文件夹。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the name changes — the file stays in the same folder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ad değişir — dosya aynı klasörde kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只改名字，文件还在原来的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只改名字，檔案還在原來的資料夾。"
          }
        }
      }
    },
    "只改这台手机上的称呼，不改动服务器上的智能体身份。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes only the name on this phone. The agent identity on the server is not changed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu telefondaki adı değiştirir. Sunucudaki ajan kimliği değişmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只改这台手机上的称呼，不改动服务器上的智能体身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只改這台手機上的稱呼，不改動伺服器上的智慧代理身份。"
          }
        }
      }
    },
    "只显示最近 50 条": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing only the latest 50"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca en son 50 gösteriliyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只显示最近 50 条"
          }
        },
