    "%@不是 UTF-8 编码、转换失败，仍按原样加入待发列表，服务器可能读不了。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't UTF-8 and couldn't be converted. It was added to the send list as-is, and the server may not be able to read it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ UTF-8 değil ve dönüştürülemedi. Gönderim listesine olduğu gibi eklendi; sunucu okuyamayabilir."
