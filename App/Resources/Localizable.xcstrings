            "value": "验证方式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證方式"
          }
        }
      }
    },
    "「%@」的系统权限已经有了，只是「允许智能体调用」还关着。打开后马上接着办刚才的事。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ already has system permission — only the “Allow agent calls” switch is off. Turn it on and the task continues right away."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」的系统权限已经有了，只是「允许智能体调用」还关着。打开后马上接着办刚才的事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」的系統權限已經有了，只是「允許智慧代理呼叫」還關著。打開後馬上接著辦剛才的事。"
          }
        }
      }
    },
