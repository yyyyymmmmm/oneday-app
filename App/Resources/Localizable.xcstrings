    },
    "检查的是总览数据能不能读到（这项服务没有专门的健康检查，拿最轻的一次读取代替）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks whether overview data can be read (this service has no dedicated health check, so the lightest read stands in for one)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查的是总览数据能不能读到（这项服务没有专门的健康检查，拿最轻的一次读取代替）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查的是總覽資料能不能讀到（這項服務沒有專門的健康檢查，拿最輕的一次讀取代替）"
          }
        }
      }
    },
    "检查的是目标列表能不能读到（这项服务没有专门的健康检查，拿最轻的一次读取代替）": {
