      }
    },
    "白名单页面与应用 · 只能打开登记过的目标": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowlisted pages and apps · Only registered targets open"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白名单页面与应用 · 只能打开登记过的目标"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "白名單頁面與應用 · 只能打開登記過的目標"
          }
        }
      }
    },
    "智能体可调用：把你带到登记过的系统设置页或几个常用应用，只能打开白名单里的目标，任意链接一律不接。这一件没有系统权限可开可关，详情页里的开关就是唯一的门；打开后你会离开 OneDay，这是这个动作本身": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your agent can: take you to a registered Settings page or a few everyday apps — allowlisted targets only; arbitrary links are never opened. There is no system permission for this one; the switch on the detail page is the only gate. Opening a target takes you out of OneDay — that is the action itself"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体可调用：把你带到登记过的系统设置页或几个常用应用，只能打开白名单里的目标，任意链接一律不接。这一件没有系统权限可开可关，详情页里的开关就是唯一的门；打开后你会离开 OneDay，这是这个动作本身"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "智慧代理可呼叫：把你帶到登記過的系統設定頁或幾個常用應用，只能打開白名單裡的目標，任意連結一律不接。這一件沒有系統權限可開可關，詳情頁裡的開關就是唯一的門；打開後你會離開 OneDay，這是這個動作本身"
          }
        }
      }
    },
    "打开白名单里的页面/应用": {
      "extractionState": "manual",
