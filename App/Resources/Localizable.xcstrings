    "全部现读现回、不存副本；电量一时读不到时如实回未知，不编数。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部现读现回、不存副本；电量一时读不到时如实回未知，不编数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全部現讀現回、不存副本；電量一時讀不到時如實回未知，不編數。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is read live and never stored. If the battery level can't be read at the moment, it honestly reports unknown — never a made-up number."
