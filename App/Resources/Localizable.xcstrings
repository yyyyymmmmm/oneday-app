      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体可调用：列出、读取、写入 OneDay 自己文件夹里的文本文件，文件夹之外的任何东西都碰不到。这一件没有系统权限可开可关，详情页里的开关就是唯一的门"
          }
