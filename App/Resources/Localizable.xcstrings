    "批准后修改会写入技能并生效；驳回则保持原样。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once approved, the changes are written into the skill and take effect. If rejected, everything stays as it was."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准后修改会写入技能并生效；驳回则保持原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批准後修改會寫入技能並生效；駁回則保持原樣。"
          }
        }
      }
    },
    "批准后写入会生效；驳回则不会写入。": {
      "extractionState": "manual",
