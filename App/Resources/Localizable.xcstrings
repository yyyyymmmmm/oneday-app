    "剪贴板内容现读现回、不存副本；读取会触发系统粘贴提示，属正常现象。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard content is read on demand and never stored. Reading triggers the system paste prompt — that's expected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板内容现读现回、不存副本；读取会触发系统粘贴提示，属正常现象。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼板內容現讀現回、不存副本；讀取會觸發系統貼上提示，屬正常現象。"
          }
        }
      }
    },
    "剪贴板里现在没有文字（可能是图片，或者本来就是空的）。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no text on the clipboard right now — it may hold an image, or simply be empty."
          }
        },
        "zh-Hans": {
          "stringUnit": {
