    "删的只是服务器上的这一份副本；手机上的数据、系统权限都不动。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this copy on the server is deleted. The data on your phone and system permissions are untouched."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca sunucudaki bu kopya silinir. Telefonunuzdaki veriler ve sistem izinleri etkilenmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
