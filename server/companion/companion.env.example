# OneDay 伴生服务配置（部署时复制为 companion.env，权限 0600）
# 一份文件、按段分发：监督者只把每段的变量注入对应模块进程，不串段。
# 模板内所有密钥位留空，严禁把真实密钥提交进任何仓库副本。

# [global] —— 监督者与 front 共用
TZ=Asia/Shanghai
COMPANION_VERSION=1.0.0
COMPANION_API_LEVEL=1
# 内部钥：nginx 的 /api/companion/ 路由验登录钥后换成它转发给 front（openssl rand -hex 32 生成）
COMPANION_SERVICE_KEY=
# Hermes 登录钥的服务端副本（front 自检与连接验活用；与 Hermes 侧 API_SERVER_KEY 同值）
HERMES_API_KEY=
HERMES_BASE=http://hermes:8642
HERMES_HOME=/opt/data
# 公网回环自检用（https://<部署域名>）；留空则自检跳过公网档并如实标注
COMPANION_PUBLIC_BASE=
# 模块默认开关（仅首次启动种入期望状态，之后以面板开关为准）
MODULE_WRITEGATE_ENABLED=1
MODULE_OVERVIEW_ENABLED=1
MODULE_BOX_ENABLED=1
MODULE_ONEDAY_ENABLED=1
MODULE_DEVICE_ENABLED=1
MODULE_IDENTITY_ENABLED=1
MODULE_FRONT_ENABLED=1

# [front] —— 面板进程
# 部署者密码的哈希（scrypt）。生成：python3 front.py --hash-password '你的密码'
# 也可以不填：首次用密钥登录后在面板里设置，哈希改存 companion-state/password.json 并优先于此处
PANEL_PASSWORD_HASH=
# 网页端登录桥（1.0.33 起）：网页端只认上面的部署者密码，front 验过后
# 在服务器内网用这里的 Hermes 管理台账号密码换取会话 Cookie 透传给
# 浏览器。值与 Hermes 部署凭据一致，只存本文件、任何接口不回传。
HERMES_DASHBOARD_USER=
HERMES_DASHBOARD_PASSWORD=
# New API 网关渠道只读代理（1.0.5 起）：front 持网关管理凭据向 App 提供
# 渠道清单（只读，渠道密钥永不经此面）。令牌＝网关 root 用户的系统访问
# 令牌，只存本文件；BASE 是伴生容器可达的网关地址。
NEWAPI_BASE_URL=
NEWAPI_ADMIN_TOKEN=
NEWAPI_ADMIN_USER_ID=

# [write-gate] —— 已于包 1.10.0（断桥批二）整模块退役：写闸走网关
# write_gate_gateway 模块（8642，API_SERVER_KEY 单源），8643 下线、
# WRITE_GATE_BRIDGE_KEY 作废；companion 内部原调 8643 的模块
# （overview/oneday）改指网关保形口，属应用步动作（见
# bridge-batch2-rollout-20261124.md），本段不再设钥。
PYTHONPATH=/opt/hermes

# [overview] —— 已于包 1.19.0（断桥批三）整模块退役：总览走网关
# overview_gateway 模块（8642，API_SERVER_KEY 单源），8644 下线、
# OVERVIEW_BRIDGE_KEY 作废；状态文件 state.json 随应用步迁至
# hermes 数据目录 overview/ 子目录原地承接。本段不再设钥。

# [box] —— 云电脑（连接记录段）
# 桥-3 已退役（2026-11-15 伴生 1.0.57）：box 桥模块本体已摘除，
# BOX_BRIDGE_KEY、BOX_PORT 随之删除。云电脑只是 front 的一条连接
# 记录：MCP_BOX_API_KEY 与 BOX_MCP_URL 保留，front 直连探针、连接
# 记录 configured 与 Hermes 登记都读它们。
MCP_BOX_API_KEY=
BOX_MCP_URL=https://mcp.box.simular.ai/mcp

# [oneday] —— 已于包 1.19.0（断桥批三）整模块退役：目标点子走网关
# oneday_gateway 模块（8642，API_SERVER_KEY 单源），8646 下线、
# ONEDAY_BRIDGE_KEY 作废；ONEDAY_CRON_CALLBACK_KEY 的值随应用步
# 迁入 hermes 部署 env。数据文件 data.json 及同目录账本随应用步
# 迁至 hermes 数据目录 oneday/ 子目录原地承接（见
# bridge-batch3-rollout-20261124.md）。本段原供桥进程的运行参数
# （ONEDAY_GEN_MODEL、TAVILY_API_KEY、FIRECRAWL_API_KEY 等）随
# 应用步改供 hermes 容器 env，键名不变；HERMES_DASH_USER /
# HERMES_DASH_PASSWORD 两键随 C-3 令牌化作废（网关内部改走
# HERMES_DASHBOARD_SESSION_TOKEN，HERMES_DASH_AUTH_MODE=password
# 时才回用本段密码）。
# [device] —— 手机设备（端口 8647）
DEVICE_BRIDGE_KEY=
DEVICE_PORT=8647
DATA_DIR=/opt/device-data
DEVICE_CALL_TIMEOUT_SEC=30
# 同步副本保存在 DATA_DIR/sync.db（权限 0600，记录型数据的唯一副本）；
# 删除副本走面板「本地数据同步」区或 device 模块的 /device/sync/delete

# [identity] —— AI 身份（端口 8648，P1 身份包）
# 改名窄工具（只动 soul 身份标题行）＋头像仓；动作经 oneday 桥
# /traces 留痕，故经 env_from 借 oneday 段的 ONEDAY_BRIDGE_KEY，
# 本段只放自己的钥与仓路径。
IDENTITY_BRIDGE_KEY=
IDENTITY_PORT=8648
AVATAR_DIR=/opt/identity-data
ONEDAY_BASE=http://127.0.0.1:8646

# [channels] —— 已于包 1.8.0（断桥批一）整模块退役：频道状态走
# Dashboard GET /api/messaging/platforms、凭据走 Dashboard PUT
# 直连（App 自 .45 起），桥端点零调用；本段钥作废。

# [fileproc]
# 文件加工（容器内端口 8652，2026-11-14 API 直连 B 包从 oneday
# 大桥拆出）：表格转码 /files/spreadsheet 与图片变体
# /media/rendition 两个只读加工端点的独立薄模块。容器内 8651
# 已被 supervisor 控制通道占用，故容器内听 8652、宿主发布
# 127.0.0.1:8651 -> 8652（nginx 与 App 口径仍走宿主 8651）。
# 本段只放自己的钥；根目录口径 SPREADSHEET_ROOT /
# RENDITION_ROOT / RENDITION_CACHE_DIR 不设时与旧 oneday 桥
# 同默认（/opt/data 与 /opt/oneday-data/renditions）。
FILEPROC_BRIDGE_KEY=
FILEPROC_PORT=8652
<redacted>
